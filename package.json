  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "lint": "vue-cli-service lint",
    "electron:build": "node scripts/build-native.js && npm run typecheck && npm run prebuild && vue-cli-service electron:build && npm run postbuild",
    "electron:serve": "node scripts/build-native.js && npm run prebuild && vue-cli-service electron:serve",
    "postinstall": "node scripts/prepare-dependencies.js",
    "rebuild": "electron-builder install-app-deps",
    "prebuild": "tsc ./src/prebuild.ts --target es2019 --module commonjs --esModuleInterop --skipLibCheck && node ./src/prebuild.js && npm run clean",
    "postbuild": "node postbuild.js",
    "clean": "node clean.js",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "docs:gen": "tsc ./src/generate-doc.ts --downlevelIteration --resolveJsonModule --esModuleInterop && node ./src/generate-doc.js && npm run clean",
    "docs:deploy": "sh docs/.vuepress/release/sync.sh deploy",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "build:mac": "node scripts/build-mac.js",
    "build:win": "node scripts/build-windows.js",
    "test:selection": "node scripts/test-selection.js && node scripts/test-popup.js && node scripts/test-popup-menu.js && node scripts/test-selection-trigger.js && node scripts/test-baidu.js && node scripts/test-selection-shortcut.js",
    "test:ai": "node scripts/test-ai-providers.js && node scripts/test-provider-setup.js && node scripts/test-streaming.js && node scripts/test-ai-settings.js"
  },
